{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openquest.local/schemas/character.json",
  "title": "OpenQuest Character",
  "description": "Player character sheet for OpenQuest JDR (Godot / JSON data contract).",
  "type": "object",
  "required": [
    "id",
    "name",
    "race",
    "class",
    "roster",
    "stats",
    "hp",
    "ac",
    "backstory"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique character identifier (e.g. char-173…-abc12)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the character."
    },
    "race": {
      "type": "string",
      "description": "Character race (Humain, Elfe, Nain, etc.)."
    },
    "class": {
      "type": "string",
      "description": "Character class or profession (Guerrier, Mage, Inspectrice, etc.)."
    },
    "roster": {
      "type": "string",
      "enum": ["general", "investigation"],
      "description": "Which game mode roster this character belongs to."
    },
    "stats": {
      "type": "object",
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "additionalProperties": false,
      "properties": {
        "str": { "type": "integer", "minimum": 1, "maximum": 30 },
        "dex": { "type": "integer", "minimum": 1, "maximum": 30 },
        "con": { "type": "integer", "minimum": 1, "maximum": 30 },
        "int": { "type": "integer", "minimum": 1, "maximum": 30 },
        "wis": { "type": "integer", "minimum": 1, "maximum": 30 },
        "cha": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "hp": {
      "type": "integer",
      "minimum": 0,
      "description": "Hit points (points de vie)."
    },
    "ac": {
      "type": "integer",
      "minimum": 0,
      "description": "Armor class (classe d'armure)."
    },
    "backstory": {
      "type": "string",
      "description": "Free-text character backstory."
    }
  }
}

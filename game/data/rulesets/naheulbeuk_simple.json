{
  "id": "naheulbeuk-simple",
  "title": "Simple — Naheulbeuk",
  "version": 1,
  "description": "Ruleset de démonstration du tier « simple » : 4 caractéristiques, défense dérivée, PV max, deux jets.",
  "fields": [
    { "id": "str", "label": "Force", "type": "int", "min": 3, "max": 18, "default": 10 },
    { "id": "ruse", "label": "Ruse", "type": "int", "min": 3, "max": 18, "default": 10 },
    { "id": "robustesse", "label": "Robustesse", "type": "int", "min": 3, "max": 18, "default": 10 },
    { "id": "charisme", "label": "Charisme", "type": "int", "min": 3, "max": 18, "default": 10 },
    { "id": "pv", "label": "Points de vie", "type": "int", "min": 0, "max": 99, "default": 6 }
  ],
  "derived": [
    { "id": "mod_str", "label": "Mod. Force", "formula": "floor((@str - 10) / 2)" },
    { "id": "mod_ruse", "label": "Mod. Ruse", "formula": "floor((@ruse - 10) / 2)" },
    { "id": "defense", "label": "Défense", "formula": "10 + floor((@robustesse - 10) / 2)" },
    { "id": "pv_max", "label": "PV max", "formula": "max(1, 6 + floor((@robustesse - 10) / 2))" },
    { "id": "initiative", "label": "Initiative", "formula": "@ruse + floor((@robustesse - 10) / 2)" }
  ],
  "rolls": [
    { "id": "attaque", "label": "Attaque", "formula": "1d20 + @mod_str", "visibility": "table" },
    { "id": "degats", "label": "Dégâts", "formula": "1d6 + @mod_str[degats]", "visibility": "table" }
  ],
  "tables": [
    {
      "id": "armes",
      "label": "Armes courantes",
      "rows": [
        { "id": "epee", "name": "Épée", "degats": "1d8" },
        { "id": "dague", "name": "Dague", "degats": "1d4" }
      ]
    }
  ]
}

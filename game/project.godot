; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited manually.

config_version=5

[application]

config/name="OpenQuest JDR"
config/description="Jeu multijoueur OpenQuest — client Godot"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ThemeColors="*res://scripts/autoload/theme_colors.gd"
GameData="*res://scripts/autoload/game_data.gd"
MapData="*res://scripts/autoload/map_data.gd"
MultiplayerManager="*res://scripts/multiplayer/multiplayer_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/min_width=800
window/size/min_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://theme/openquest_theme.tres"

[rendering]

renderer/rendering_method="forward_plus"

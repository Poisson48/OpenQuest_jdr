; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="OpenQuest JDR"
config/description="Jeu multijoueur OpenQuest — client Godot"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ThemeColors="*res://scripts/autoload/theme_colors.gd"
UiLayout="*res://scripts/autoload/ui_layout.gd"
GameData="*res://scripts/autoload/game_data.gd"
MapData="*res://scripts/autoload/map_data.gd"
MultiplayerManager="*res://scripts/multiplayer/multiplayer_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/size/min_width=800
window/size/min_height=500

[gui]

theme/custom="res://theme/openquest_theme.tres"

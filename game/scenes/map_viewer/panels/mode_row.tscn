[gd_scene load_steps=2 format=3]

[sub_resource type="ButtonGroup" id="ButtonGroup_mode"]
resource_name = "MapRenderMode"

[node name="ModeRow" type="HBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="LblMode" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "Mode carte :"

[node name="BtnModeSimple" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
button_group = SubResource("ButtonGroup_mode")
tooltip_text = "Tuiles pixel — exploration, lieux, marqueurs"
text = "▦ Simple"

[node name="BtnModeComplex" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
button_group = SubResource("ButtonGroup_mode")
tooltip_text = "Battlemap 3D — diorama illustré ou VTT tactique"
text = "⚙️ Complexe"

[node name="LblModeHint" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CaptionLabel"
theme_override_font_sizes/font_size = 12
text = ""
autowrap_mode = 3

[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/session/panels/action_bar.gd" id="1_script"]

[node name="ActionBar" type="PanelContainer"]
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2
size_flags_horizontal = 3
size_flags_vertical = 0
theme_type_variation = &"DockPanel"
script = ExtResource("1_script")

[node name="Col" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LblTurn" type="Label" parent="Col"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "Tour en cours"
clip_text = true

[node name="LblHint" type="Label" parent="Col"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "Décrivez l'action de votre personnage."
autowrap_mode = 3

[node name="Suggestions" type="ScrollContainer" parent="Col"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
vertical_scroll_mode = 0

[node name="SuggestionRow" type="HBoxContainer" parent="Col/Suggestions"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="BtnExplore" type="Button" parent="Col/Suggestions/SuggestionRow"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_type_variation = &"ToolButton"
tooltip_text = "J'explore attentivement les environs à la recherche d'indices."
text = "Explorer"

[node name="BtnTalk" type="Button" parent="Col/Suggestions/SuggestionRow"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_type_variation = &"ToolButton"
tooltip_text = "J'engage la conversation avec les personnes présentes."
text = "Discuter"

[node name="BtnInspect" type="Button" parent="Col/Suggestions/SuggestionRow"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_type_variation = &"ToolButton"
tooltip_text = "J'examine minutieusement cet endroit."
text = "Examiner"

[node name="BtnFight" type="Button" parent="Col/Suggestions/SuggestionRow"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_type_variation = &"ToolButton"
tooltip_text = "Je dégaine mon arme et me prépare au combat !"
text = "Combattre"

[node name="InputRow" type="HBoxContainer" parent="Col"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="ActionInput" type="LineEdit" parent="Col/InputRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Que faites-vous ?"

[node name="BtnSend" type="Button" parent="Col/InputRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_type_variation = &"AccentButton"
tooltip_text = "Soumettre votre action"
text = "Envoyer"

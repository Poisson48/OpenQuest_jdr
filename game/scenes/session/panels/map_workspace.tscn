[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/session/panels/map_workspace.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/session/panels/map_navigator.tscn" id="2_navigator"]
[ext_resource type="PackedScene" path="res://scenes/session/panels/map_stage.tscn" id="3_stage"]
[ext_resource type="PackedScene" path="res://scenes/session/panels/map_toolbar.tscn" id="4_toolbar"]

[node name="MapWorkspace" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 4
script = ExtResource("1_script")

[node name="MapNavigator" parent="." instance=ExtResource("2_navigator")]
unique_name_in_owner = true
layout_mode = 2

[node name="MapStage" parent="." instance=ExtResource("3_stage")]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="MapToolbar" parent="." instance=ExtResource("4_toolbar")]
unique_name_in_owner = true
layout_mode = 2

[node name="EmptyState" type="PanelContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_type_variation = &"InsetPanel"

[node name="EmptyVBox" type="VBoxContainer" parent="EmptyState"]
layout_mode = 2
theme_override_constants/separation = 14
alignment = 1

[node name="EmptyTitle" type="Label" parent="EmptyState/EmptyVBox"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
theme_override_font_sizes/font_size = 18
text = "Aucune carte dans cette partie"
horizontal_alignment = 1
autowrap_mode = 3

[node name="EmptyHint" type="Label" parent="EmptyState/EmptyVBox"]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
theme_override_font_sizes/font_size = 14
text = "Une aventure jouable a besoin d’au moins une carte. Retourne au Hub pour en créer une, puis relance la partie depuis le setup."
horizontal_alignment = 1
autowrap_mode = 3

[node name="EmptyActions" type="HBoxContainer" parent="EmptyState/EmptyVBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 12

[node name="BtnEmptyHub" type="Button" parent="EmptyState/EmptyVBox/EmptyActions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 40)
layout_mode = 2
theme_type_variation = &"AccentButton"
text = "← Retour au Hub"

[node name="BtnEmptyMaps" type="Button" parent="EmptyState/EmptyVBox/EmptyActions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 40)
layout_mode = 2
text = "Ouvrir les Cartes"

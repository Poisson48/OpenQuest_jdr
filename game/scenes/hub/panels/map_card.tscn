visible = false
layout_mode = 2
theme_type_variation = &"CaptionLabel"
theme_override_font_sizes/font_size = 14
text = "Scénario :"
autowrap_mode = 3

[node name="LblDesc" type="Label" parent="VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/hub/panels/map_card.gd" id="1_script"]

[node name="MapCard" type="PanelContainer"]
custom_minimum_size = Vector2(240, 0)
size_flags_horizontal = 3
theme_type_variation = &"InsetPanel"
script = ExtResource("1_script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LblBadge" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BadgeLabel"
theme_override_font_sizes/font_size = 14
text = "⚔️ 0×0 · 0 carrés"

[node name="LblTitle" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
theme_override_font_sizes/font_size = 16
text = "Sans titre"
autowrap_mode = 3

[node name="LblScenario" type="Label" parent="VBox"]

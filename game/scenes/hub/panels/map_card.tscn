[node name="LblMeta" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
theme_override_font_sizes/font_size = 14
text = "0 marqueur(s)"

[node name="Actions" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="BtnPreview" type="Button" parent="VBox/Actions"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Aperçu"

[node name="BtnDemo" type="Button" parent="VBox/Actions"]
unique_name_in_owner = true

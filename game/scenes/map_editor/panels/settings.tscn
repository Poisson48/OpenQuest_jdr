layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Hauteur de la carte en cases. Le contenu existant est conservé en haut à gauche."
min_value = 4.0
max_value = 128.0
value = 12.0
step = 1.0

[node name="LblGrid" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "⊞ Grille"

[node name="ChkGrid" type="CheckBox" parent="."]

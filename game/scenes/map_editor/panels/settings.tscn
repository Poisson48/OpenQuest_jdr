[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/maps/editor/map_editor_settings_panel.gd" id="1_script"]

[node name="Carte" type="VBoxContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 5
script = ExtResource("1_script")

[node name="LblBg" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "🖼 Fond de carte"

[node name="LblBgStatus" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
autowrap_mode = 3
text = ""

[node name="BgRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="BtnImportBg" type="Button" parent="BgRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Choisit l'image de fond (PNG/JPEG/WebP). Les dimensions de la grille sont proposées d'après l'image."
text = "Importer PNG…"

[node name="BtnImportOverlay" type="Button" parent="BgRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Ajoute un calque image au-dessus du fond (PNG/WebP), utile pour les étages ou les zones surélevées."
text = "Calque +"

[node name="BtnRemoveBg" type="Button" parent="BgRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DangerButton"
tooltip_text = "Retire le fond illustré : le sol est alors généré à partir du terrain."
text = "✕"

[node name="LblBgHint" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
theme_override_font_sizes/font_size = 10
text = "Fond : image importée, puis lieux, décors et objets 3D se posent par-dessus."
autowrap_mode = 3

[node name="LblSize" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "📐 Dimensions (cases)"

[node name="SizeRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="WidthCol" type="VBoxContainer" parent="SizeRow"]
layout_mode = 2

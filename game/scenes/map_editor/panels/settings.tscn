theme_override_constants/separation = 1

[node name="LblWidth" type="Label" parent="SizeRow/WidthCol"]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "Largeur"

[node name="SpinWidth" type="SpinBox" parent="SizeRow/WidthCol"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

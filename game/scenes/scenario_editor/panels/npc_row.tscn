[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/scenario_editor/panels/npc_row.gd" id="1_script"]

[node name="NpcRow" type="PanelContainer"]
size_flags_horizontal = 3
theme_type_variation = &"InsetPanel"

# Port du serveur WebSocket
PORT=8080

# Hôte d'écoute (0.0.0.0 = accessible sur le réseau local)
HOST=0.0.0.0

# Port d'écoute du serveur MCP (transport HTTP optionnel — le transport par
# défaut de `npm run mcp` est stdio, ce port sert aux intégrations HTTP futures)
MCP_PORT=3100

# Clé API OpenAI — si définie, le serveur MCP enrichit la narration du MJ IA
# avec un LLM en plus du moteur à règles (ai-gm.ts). Laisser vide pour rester
# 100% rule-based.
OPENAI_API_KEY=

# Clé API Anthropic — utilisée comme alternative à OPENAI_API_KEY pour
# l'enrichissement narratif du MJ IA (priorité à OPENAI_API_KEY si les deux
# sont définies).
ANTHROPIC_API_KEY=

artifacts/tripo-review/rock-kit/*.glb
artifacts/tripo-review/rock-kit/_render_*.png
artifacts/tripo-review/rock-kit/recolored/
artifacts/tripo-review/rock-kit/recolored_1024/
artifacts/tripo-review/rock-kit/renders/
